[
{"id":"how-much","en":"How much is this?","say":"하우 머치 이즈 디스?","ko":"이거 얼마예요?","when":"가게에서 값을 물을 때","key":"much","reply":["It's twenty dollars.","20달러예요."]},
{"id":"check-please","en":"Check, please.","say":"첵, 플리즈.","ko":"계산서 주세요.","when":"식당에서 계산하려고 할 때","key":"Check","reply":["Sure, one moment.","네, 잠시만요."]},
{"id":"where-restroom","en":"Where is the restroom?","say":"웨어 이즈 더 레스트룸?","ko":"화장실이 어디예요?","when":"화장실을 찾을 때","key":"restroom","reply":["It's down the hall on the left.","복도 끝 왼쪽에 있어요."]},
{"id":"one-more","en":"Can I have one more, please?","say":"캔 아이 해브 원 모어, 플리즈?","ko":"하나 더 주시겠어요?","when":"음식이나 물건을 하나 더 달라고 할 때","key":"more","reply":["Of course.","물론이죠."]},
{"id":"water","en":"Could I get some water?","say":"쿠드 아이 겟 썸 워러?","ko":"물 좀 주시겠어요?","when":"식당에서 물을 달라고 할 때","key":"water","reply":["Still or sparkling?","일반 물이요, 탄산수요?"]},
{"id":"just-looking","en":"I'm just looking.","say":"아임 저스트 루킹.","ko":"그냥 구경하는 중이에요.","when":"가게 직원이 도와줄지 물을 때","key":"looking","reply":["Let me know if you need anything.","필요한 게 있으면 말씀하세요."]},
{"id":"take-photo","en":"Could you take a picture of us?","say":"쿠쥬 테이크 어 픽처 오브 어스?","ko":"저희 사진 좀 찍어 주시겠어요?","when":"관광지에서 사진을 부탁할 때","key":"picture","reply":["Sure! Say cheese.","그럼요! 김치 하세요."]},
{"id":"speak-slowly","en":"Could you speak slowly, please?","say":"쿠쥬 스픽 슬로울리, 플리즈?","ko":"천천히 말씀해 주시겠어요?","when":"상대 말이 너무 빠를 때","key":"slowly","reply":["Sorry, I'll speak slower.","미안해요, 천천히 말할게요."]},
{"id":"say-again","en":"Could you say that again?","say":"쿠쥬 세이 댓 어게인?","ko":"다시 한번 말씀해 주시겠어요?","when":"잘 못 알아들었을 때","key":"again","reply":["Sure. Gate number twelve.","네. 12번 게이트예요."]},
{"id":"dont-understand","en":"I don't understand.","say":"아이 돈 언더스탠드.","ko":"이해를 못 했어요.","when":"무슨 말인지 모를 때","key":"understand","reply":["Let me show you on the map.","지도로 보여 드릴게요."]},
{"id":"window-seat","en":"Can I have a window seat?","say":"캔 아이 해브 어 윈도우 시트?","ko":"창가 자리로 주시겠어요?","when":"비행기 탑승 수속을 할 때","key":"window","reply":["Let me check. Yes, 23A.","확인해 볼게요. 네, 23A예요."]},
{"id":"aisle-seat","en":"I'd like an aisle seat.","say":"아이드 라잌 언 아일 시트.","ko":"통로 쪽 자리로 주세요.","when":"비행기 좌석을 고를 때","key":"aisle","reply":["No problem.","그렇게 해 드릴게요."]},
{"id":"check-in","en":"I'd like to check in.","say":"아이드 라잌 투 첵 인.","ko":"체크인하려고요.","when":"호텔에 도착했을 때","key":"check","reply":["May I see your passport?","여권 좀 보여 주시겠어요?"]},
{"id":"reservation","en":"I have a reservation.","say":"아이 해브 어 레저베이션.","ko":"예약했어요.","when":"호텔이나 식당에 예약하고 왔을 때","key":"reservation","reply":["Under what name?","어느 분 이름으로요?"]},
{"id":"checkout-time","en":"What time is check-out?","say":"왓 타임 이즈 첵아웃?","ko":"체크아웃은 몇 시예요?","when":"호텔 퇴실 시간을 물을 때","key":"time","reply":["It's at eleven.","11시예요."]},
{"id":"wifi-password","en":"What's the Wi-Fi password?","say":"왓츠 더 와이파이 패스워드?","ko":"와이파이 비밀번호가 뭐예요?","when":"숙소나 카페에서 인터넷을 쓸 때","key":"password","reply":["It's on the back of your key card.","카드키 뒷면에 있어요."]},
{"id":"keep-luggage","en":"Can you keep my luggage?","say":"캔 유 킵 마이 러기지?","ko":"짐 좀 맡아 주시겠어요?","when":"체크아웃 후 짐을 맡길 때","key":"luggage","reply":["Sure, here's your tag.","네, 여기 번호표요."]},
{"id":"room-clean","en":"Could you clean my room?","say":"쿠쥬 클린 마이 룸?","ko":"방 청소 좀 해 주시겠어요?","when":"호텔 방 청소를 부탁할 때","key":"clean","reply":["We'll send someone right away.","바로 사람을 보내 드릴게요."]},
{"id":"no-hot-water","en":"There's no hot water.","say":"데어즈 노 핫 워러.","ko":"뜨거운 물이 안 나와요.","when":"숙소에 문제가 생겼을 때","key":"hot","reply":["I'm sorry. We'll fix it now.","죄송해요. 지금 고쳐 드릴게요."]},
{"id":"how-get-to","en":"How do I get to the station?","say":"하우 두 아이 겟 투 더 스테이션?","ko":"역에 어떻게 가요?","when":"길을 물을 때","key":"station","reply":["Go straight two blocks.","두 블록 곧장 가세요."]},
{"id":"is-it-far","en":"Is it far from here?","say":"이즈 잇 파 프롬 히어?","ko":"여기서 멀어요?","when":"거리를 물을 때","key":"far","reply":["It's about ten minutes on foot.","걸어서 10분쯤이에요."]},
{"id":"take-me","en":"Please take me to this address.","say":"플리즈 테이크 미 투 디스 어드레스.","ko":"이 주소로 가 주세요.","when":"택시에 타서 주소를 보여 줄 때","key":"address","reply":["Okay. Fasten your seatbelt.","알겠어요. 안전벨트 매세요."]},
{"id":"stop-here","en":"Please stop here.","say":"플리즈 스탑 히어.","ko":"여기서 세워 주세요.","when":"택시에서 내릴 때","key":"stop","reply":["That'll be fifteen dollars.","15달러입니다."]},
{"id":"which-bus","en":"Which bus goes downtown?","say":"위치 버스 고즈 다운타운?","ko":"어느 버스가 시내로 가요?","when":"정류장에서 버스를 찾을 때","key":"bus","reply":["Take the number 5.","5번 타세요."]},
{"id":"one-ticket","en":"One ticket to London, please.","say":"원 티켓 투 런던, 플리즈.","ko":"런던행 표 한 장 주세요.","when":"기차표를 살 때","key":"ticket","reply":["One way or round trip?","편도요, 왕복이요?"]},
{"id":"round-trip","en":"Round trip, please.","say":"라운드 트립, 플리즈.","ko":"왕복으로 주세요.","when":"표를 왕복으로 살 때","key":"Round","reply":["That's forty-two euros.","42유로예요."]},
{"id":"next-train","en":"When is the next train?","say":"웬 이즈 더 넥스트 트레인?","ko":"다음 기차는 언제예요?","when":"기차 시간을 물을 때","key":"next","reply":["In twenty minutes.","20분 뒤에 있어요."]},
{"id":"this-seat","en":"Is this seat taken?","say":"이즈 디스 시트 테이큰?","ko":"이 자리 주인 있어요?","when":"빈자리에 앉기 전에 물을 때","key":"seat","reply":["No, go ahead.","아니요, 앉으세요."]},
{"id":"lost","en":"I think I'm lost.","say":"아이 띵크 아임 로스트.","ko":"길을 잃은 것 같아요.","when":"길을 잃었을 때","key":"lost","reply":["Where are you trying to go?","어디 가시는 길이에요?"]},
{"id":"near-here","en":"Is there a pharmacy near here?","say":"이즈 데어 어 파머시 니어 히어?","ko":"근처에 약국 있어요?","when":"약국을 찾을 때","key":"pharmacy","reply":["There's one across the street.","길 건너에 하나 있어요."]},
{"id":"table-two","en":"A table for two, please.","say":"어 테이블 포 투, 플리즈.","ko":"두 명 자리 주세요.","when":"식당에 들어갈 때","key":"table","reply":["Right this way.","이쪽으로 오세요."]},
{"id":"menu","en":"Can I see the menu?","say":"캔 아이 시 더 메뉴?","ko":"메뉴판 좀 볼 수 있을까요?","when":"주문하기 전에","key":"menu","reply":["Here you are.","여기 있어요."]},
{"id":"recommend","en":"What do you recommend?","say":"왓 두 유 레커멘드?","ko":"뭐가 맛있어요?","when":"메뉴를 추천받고 싶을 때","key":"recommend","reply":["The steak is very popular.","스테이크가 인기가 많아요."]},
{"id":"ill-have","en":"I'll have this one.","say":"아일 해브 디스 원.","ko":"이걸로 할게요.","when":"메뉴를 가리키며 주문할 때","key":"have","reply":["Good choice.","잘 고르셨어요."]},
{"id":"not-spicy","en":"Not too spicy, please.","say":"낫 투 스파이시, 플리즈.","ko":"너무 맵지 않게 해 주세요.","when":"음식 맵기를 부탁할 때","key":"spicy","reply":["Okay, mild it is.","네, 순하게 해 드릴게요."]},
{"id":"allergic","en":"I'm allergic to peanuts.","say":"아임 얼러직 투 피넛츠.","ko":"땅콩 알레르기가 있어요.","when":"음식 알레르기를 알릴 때","key":"allergic","reply":["I'll tell the chef.","주방에 말해 둘게요."]},
{"id":"to-go","en":"Can I get this to go?","say":"캔 아이 겟 디스 투 고?","ko":"이거 포장해 주시겠어요?","when":"남은 음식이나 주문을 포장할 때","key":"go","reply":["Sure, I'll box it up.","네, 담아 드릴게요."]},
{"id":"delicious","en":"It was delicious.","say":"잇 워즈 딜리셔스.","ko":"정말 맛있었어요.","when":"식사를 마치고 인사할 때","key":"delicious","reply":["Thank you! Come again.","고마워요! 또 오세요."]},
{"id":"card-ok","en":"Can I pay by card?","say":"캔 아이 페이 바이 카드?","ko":"카드로 계산해도 돼요?","when":"결제 수단을 물을 때","key":"card","reply":["Yes, we take all cards.","네, 모든 카드 돼요."]},
{"id":"separate","en":"Can we pay separately?","say":"캔 위 페이 세퍼럿리?","ko":"따로 계산해도 될까요?","when":"일행끼리 나눠 낼 때","key":"separately","reply":["Of course.","물론이죠."]},
{"id":"receipt","en":"Can I have a receipt?","say":"캔 아이 해브 어 리시트?","ko":"영수증 주시겠어요?","when":"계산 후 영수증이 필요할 때","key":"receipt","reply":["Here's your receipt.","영수증 여기 있어요."]},
{"id":"too-expensive","en":"That's too expensive.","say":"댓츠 투 익스펜시브.","ko":"너무 비싸요.","when":"시장에서 값을 깎고 싶을 때","key":"expensive","reply":["Okay, I'll give you a discount.","좋아요, 깎아 드릴게요."]},
{"id":"discount","en":"Can you give me a discount?","say":"캔 유 기브 미 어 디스카운트?","ko":"좀 깎아 주실 수 있어요?","when":"값을 흥정할 때","key":"discount","reply":["How about ten percent off?","10% 할인 어때요?"]},
{"id":"try-on","en":"Can I try this on?","say":"캔 아이 트라이 디스 온?","ko":"이거 입어 봐도 돼요?","when":"옷 가게에서","key":"try","reply":["The fitting room is over there.","탈의실은 저쪽이에요."]},
{"id":"bigger-size","en":"Do you have a bigger size?","say":"두 유 해브 어 비거 사이즈?","ko":"더 큰 치수 있어요?","when":"옷이나 신발이 작을 때","key":"bigger","reply":["Let me check in the back.","창고에서 찾아볼게요."]},
{"id":"other-color","en":"Do you have this in another color?","say":"두 유 해브 디스 인 어나더 컬러?","ko":"다른 색깔도 있어요?","when":"다른 색을 찾을 때","key":"color","reply":["We have it in blue and black.","파란색과 검은색이 있어요."]},
{"id":"gift-wrap","en":"Could you gift-wrap it?","say":"쿠쥬 기프트랩 잇?","ko":"선물 포장해 주시겠어요?","when":"선물을 살 때","key":"wrap","reply":["Sure, that's free.","네, 무료로 해 드려요."]},
{"id":"tax-refund","en":"Can I get a tax refund?","say":"캔 아이 겟 어 택스 리펀드?","ko":"세금 환급 받을 수 있어요?","when":"면세 쇼핑을 할 때","key":"refund","reply":["Yes, please show your passport.","네, 여권을 보여 주세요."]},
{"id":"nice-meet","en":"Nice to meet you.","say":"나이스 투 밋 유.","ko":"만나서 반가워요.","when":"처음 만난 사람에게 인사할 때","key":"meet","reply":["Nice to meet you, too.","저도 만나서 반가워요."]},
{"id":"from-korea","en":"I'm from Korea.","say":"아임 프롬 코리아.","ko":"한국에서 왔어요.","when":"어디서 왔는지 물을 때","key":"from","reply":["Oh, I love Korean food!","오, 한국 음식 정말 좋아해요!"]},
{"id":"first-time","en":"It's my first time here.","say":"잇츠 마이 퍼스트 타임 히어.","ko":"여기 처음 와 봤어요.","when":"여행지에서 대화할 때","key":"first","reply":["Welcome! Enjoy your stay.","환영해요! 즐거운 시간 보내세요."]},
{"id":"vacation","en":"I'm here on vacation.","say":"아임 히어 온 버케이션.","ko":"휴가로 왔어요.","when":"입국 심사나 대화에서 방문 목적을 말할 때","key":"vacation","reply":["How long will you stay?","얼마나 머무르세요?"]},
{"id":"stay-week","en":"I'll stay for a week.","say":"아일 스테이 포 어 위크.","ko":"일주일 머물 거예요.","when":"입국 심사에서 체류 기간을 말할 때","key":"week","reply":["Enjoy your trip.","좋은 여행 되세요."]},
{"id":"thank-you-much","en":"Thank you so much.","say":"땡큐 쏘 머치.","ko":"정말 고마워요.","when":"도움을 받았을 때","key":"Thank","reply":["You're welcome.","천만에요."]},
{"id":"excuse-me","en":"Excuse me.","say":"익스큐즈 미.","ko":"실례합니다.","when":"말을 걸거나 길을 비켜 달라고 할 때","key":"Excuse","reply":["Yes? How can I help?","네? 무엇을 도와드릴까요?"]},
{"id":"im-sorry","en":"I'm sorry, I'm late.","say":"아임 쏘리, 아임 레이트.","ko":"늦어서 미안해요.","when":"약속에 늦었을 때","key":"late","reply":["No worries.","괜찮아요."]},
{"id":"no-problem","en":"No problem.","say":"노 프라블럼.","ko":"괜찮아요. / 문제없어요.","when":"상대가 고맙다거나 미안하다고 할 때","key":"problem","reply":["Thanks anyway.","어쨌든 고마워요."]},
{"id":"help-me","en":"Could you help me?","say":"쿠쥬 헬프 미?","ko":"좀 도와주시겠어요?","when":"도움이 필요할 때","key":"help","reply":["Sure, what do you need?","그럼요, 뭐가 필요하세요?"]},
{"id":"call-taxi","en":"Could you call a taxi for me?","say":"쿠쥬 콜 어 택시 포 미?","ko":"택시 좀 불러 주시겠어요?","when":"호텔이나 식당에서 택시를 부탁할 때","key":"taxi","reply":["It'll be here in five minutes.","5분 뒤에 도착해요."]},
{"id":"see-doctor","en":"I need to see a doctor.","say":"아이 니드 투 시 어 닥터.","ko":"의사를 만나야 해요.","when":"몸이 아플 때","key":"doctor","reply":["I'll call one for you.","불러 드릴게요."]},
{"id":"headache","en":"I have a headache.","say":"아이 해브 어 헤데이크.","ko":"머리가 아파요.","when":"약국에서 증상을 말할 때","key":"headache","reply":["Take this twice a day.","이걸 하루 두 번 드세요."]},
{"id":"lost-wallet","en":"I lost my wallet.","say":"아이 로스트 마이 월릿.","ko":"지갑을 잃어버렸어요.","when":"물건을 잃어버렸을 때","key":"wallet","reply":["Let's go to the lost and found.","분실물 센터로 가 봐요."]},
{"id":"emergency","en":"It's an emergency.","say":"잇츠 언 이머전시.","ko":"급한 일이에요.","when":"긴급한 도움이 필요할 때","key":"emergency","reply":["Stay calm. I'll call for help.","진정하세요. 도움을 부를게요."]},
{"id":"what-time-open","en":"What time do you open?","say":"왓 타임 두 유 오픈?","ko":"몇 시에 문 열어요?","when":"가게나 관광지 운영 시간을 물을 때","key":"open","reply":["We open at nine.","9시에 열어요."]},
{"id":"how-long-take","en":"How long does it take?","say":"하우 롱 더즈 잇 테이크?","ko":"얼마나 걸려요?","when":"시간이 얼마나 걸리는지 물을 때","key":"long","reply":["About thirty minutes.","30분쯤이요."]},
{"id":"tickets-two","en":"Two adults, please.","say":"투 어덜츠, 플리즈.","ko":"어른 두 명이요.","when":"입장권을 살 때","key":"adults","reply":["That's thirty dollars in total.","모두 30달러예요."]},
{"id":"senior-discount","en":"Is there a senior discount?","say":"이즈 데어 어 시니어 디스카운트?","ko":"경로 할인 있어요?","when":"입장료나 교통비를 낼 때","key":"senior","reply":["Yes, if you're over sixty-five.","네, 65세 이상이시면요."]},
{"id":"photo-ok","en":"Can I take pictures here?","say":"캔 아이 테이크 픽처스 히어?","ko":"여기서 사진 찍어도 돼요?","when":"박물관이나 공연장에서","key":"pictures","reply":["Yes, but no flash, please.","네, 플래시만 끄세요."]},
{"id":"map","en":"Do you have a map?","say":"두 유 해브 어 맵?","ko":"지도 있어요?","when":"관광 안내소에서","key":"map","reply":["Here's a free one.","무료 지도 여기 있어요."]},
{"id":"good-morning","en":"Good morning! How are you?","say":"굿 모닝! 하우 아 유?","ko":"좋은 아침이에요! 잘 지내요?","when":"아침에 만난 사람에게 인사할 때","key":"morning","reply":["I'm great, thanks. And you?","잘 지내요, 고마워요. 당신은요?"]},
{"id":"have-nice-day","en":"Have a nice day!","say":"해브 어 나이스 데이!","ko":"좋은 하루 보내세요!","when":"헤어질 때 인사로","key":"day","reply":["You too!","당신도요!"]},
{"id":"see-you","en":"See you tomorrow.","say":"씨 유 투마로우.","ko":"내일 봐요.","when":"다음 날 다시 만날 사람과 헤어질 때","key":"tomorrow","reply":["See you!","내일 봐요!"]},
{"id":"good-idea","en":"That's a good idea.","say":"댓츠 어 굿 아이디어.","ko":"좋은 생각이에요.","when":"상대 제안에 찬성할 때","key":"idea","reply":["Great, let's do it.","좋아요, 그렇게 해요."]},
{"id":"sounds-good","en":"Sounds good to me.","say":"사운즈 굿 투 미.","ko":"저는 좋아요.","when":"약속이나 제안에 동의할 때","key":"Sounds","reply":["Perfect. See you at six.","좋아요. 6시에 봐요."]},
{"id":"no-thanks","en":"No, thank you.","say":"노, 땡큐.","ko":"아니요, 괜찮아요.","when":"권유를 정중히 거절할 때","key":"No","reply":["Okay, let me know.","알겠어요, 필요하면 말해요."]},
{"id":"wait-moment","en":"Just a moment, please.","say":"저스트 어 모먼트, 플리즈.","ko":"잠시만 기다려 주세요.","when":"상대에게 기다려 달라고 할 때","key":"moment","reply":["Take your time.","천천히 하세요."]},
{"id":"after-you","en":"After you.","say":"애프터 유.","ko":"먼저 가세요.","when":"문이나 엘리베이터에서 양보할 때","key":"After","reply":["Thank you.","고마워요."]},
{"id":"congrats","en":"Congratulations!","say":"컨그래츄레이션스!","ko":"축하해요!","when":"좋은 일을 축하할 때","key":"Congratulations","reply":["Thank you so much!","정말 고마워요!"]},
{"id":"happy-birthday","en":"Happy birthday to you!","say":"해피 버쓰데이 투 유!","ko":"생일 축하해요!","when":"생일을 축하할 때","key":"birthday","reply":["Aww, thank you!","어머, 고마워요!"]},
{"id":"take-care","en":"Take care of yourself.","say":"테이크 케어 오브 유어셀프.","ko":"몸 건강히 지내요.","when":"헤어지며 안부를 전할 때","key":"care","reply":["You too. Bye!","당신도요. 안녕!"]},
{"id":"weather","en":"The weather is beautiful today.","say":"더 웨더 이즈 뷰티풀 투데이.","ko":"오늘 날씨 정말 좋네요.","when":"가볍게 말을 걸 때","key":"weather","reply":["It really is.","정말 그래요."]},
{"id":"grandchildren","en":"These are my grandchildren.","say":"디즈 아 마이 그랜칠드런.","ko":"제 손주들이에요.","when":"사진을 보여 주며 가족을 소개할 때","key":"grandchildren","reply":["They're so cute!","너무 귀엽네요!"]},
{"id":"retired","en":"I'm retired now.","say":"아임 리타이어드 나우.","ko":"지금은 은퇴했어요.","when":"무슨 일을 하는지 물을 때","key":"retired","reply":["Lucky you! Enjoy it.","부럽네요! 즐기세요."]},
{"id":"hobby","en":"I enjoy hiking on weekends.","say":"아이 인조이 하이킹 온 위켄즈.","ko":"주말엔 등산을 즐겨요.","when":"취미를 이야기할 때","key":"hiking","reply":["Me too! Where do you go?","저도요! 어디로 가세요?"]},
{"id":"video-call","en":"Let's have a video call.","say":"렛츠 해브 어 비디오 콜.","ko":"영상 통화해요.","when":"멀리 사는 가족과 연락할 때","key":"video","reply":["Okay, I'll call you at eight.","좋아요, 8시에 걸게요."]},
{"id":"how-was","en":"How was your trip?","say":"하우 워즈 유어 트립?","ko":"여행 어땠어요?","when":"여행에서 돌아온 사람에게","key":"trip","reply":["It was amazing!","정말 좋았어요!"]},
{"id":"miss-you","en":"I miss you.","say":"아이 미스 유.","ko":"보고 싶어요.","when":"멀리 있는 가족·친구에게","key":"miss","reply":["I miss you, too.","나도 보고 싶어요."]},
{"id":"proud","en":"I'm so proud of you.","say":"아임 쏘 프라우드 오브 유.","ko":"네가 정말 자랑스러워.","when":"가족이나 친구를 칭찬할 때","key":"proud","reply":["Thanks, that means a lot.","고마워요, 큰 힘이 돼요."]},
{"id":"cheers","en":"Cheers!","say":"치어스!","ko":"건배!","when":"잔을 부딪칠 때","key":"Cheers","reply":["Cheers!","건배!"]},
{"id":"enjoy-meal","en":"Enjoy your meal.","say":"인조이 유어 밀.","ko":"맛있게 드세요.","when":"식사를 시작할 때","key":"meal","reply":["Thank you, you too.","고마워요, 당신도요."]},
{"id":"where-from","en":"Where are you from?","say":"웨어 아 유 프롬?","ko":"어디서 오셨어요?","when":"처음 만난 사람에게 물을 때","key":"Where","reply":["I'm from Canada.","캐나다에서 왔어요."]},
{"id":"what-name","en":"What's your name?","say":"왓츠 유어 네임?","ko":"이름이 뭐예요?","when":"상대 이름을 물을 때","key":"name","reply":["I'm Anna. And you?","애나예요. 당신은요?"]},
{"id":"good-night","en":"Good night. Sleep well.","say":"굿 나잇. 슬립 웰.","ko":"잘 자요. 푹 쉬세요.","when":"자기 전에 인사할 때","key":"Sleep","reply":["Good night!","잘 자요!"]}
]
